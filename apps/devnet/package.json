{
  "name": "@agent-chain/devnet",
  "version": "0.1.0",
  "private": true,
  "description": "AGENT CHAIN Devnet: Hardhat node (chainId 11190, 250 ms blocks), contracts, deploy script and activity bot",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "hardhat compile",
    "node": "hardhat node --hostname 0.0.0.0 --port 8545",
    "deploy": "hardhat run scripts/deploy.ts --network devnet",
    "bot": "hardhat run scripts/bot.ts --network devnet",
    "test": "hardhat test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@types/node": "^20.14.0",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
