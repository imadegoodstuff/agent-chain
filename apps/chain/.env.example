# ──────────────────────────────────────────────────────────────────────────────
# AGENT CHAIN — apps/chain environment
# Copy to .env (gitignored). PRIVATE KEYS LIVE ONLY HERE. Never commit .env.
# `npm run keys:generate` fills the four *_PRIVATE_KEY lines below if they are empty.
# ──────────────────────────────────────────────────────────────────────────────

# Which network the scripts target: local | testnet | mainnet
NETWORK=testnet

# Parent chain RPC URLs (use a paid/dedicated endpoint for the node; public ones rate-limit eth_getLogs)
PARENT_CHAIN_RPC_LOCAL=http://127.0.0.1:8545
PARENT_CHAIN_RPC_TESTNET=https://bsc-testnet-dataseed.bnbchain.org
PARENT_CHAIN_RPC_MAINNET=https://bsc-dataseed.bnbchain.org

# AGENT CHAIN L2 RPC (raw sequencer, private) — used by set-l2-params / smoke-test
L2_RPC_URL=http://127.0.0.1:8547
# Public gateway URL — used by smoke-test
GATEWAY_URL=https://agentchain-gateway.fly.dev

# ── Keys (hex, 0x-prefixed). Generated by scripts/generate-keys.ts ────────────
# Chain owner = deployer of RollupCreator + caller of createRollup + ArbOwner on L2
CHAIN_OWNER_PRIVATE_KEY=
# Posts batches to BSC (needs BNB)
BATCH_POSTER_PRIVATE_KEY=
# BoLD validator / staker (needs BNB + WBNB stake)
VALIDATOR_PRIVATE_KEY=
# Sequencer identity: signs the sequencer feed (and future preconfirmation receipts). Needs no funds.
SEQUENCER_PRIVATE_KEY=

# Alias used by create-rollup.ts / deploy-creator.ts (defaults to CHAIN_OWNER_PRIVATE_KEY if empty)
DEPLOYER_PRIVATE_KEY=

# ── Tokens ───────────────────────────────────────────────────────────────────
# Testnet gas token (deployed by deploy-tantb.ts; written to deployments/testnet/tokens.json too)
TANTB_ADDRESS=
# Mainnet gas token: ANTB (bStocks Anthropic) — fixed
ANTB_ADDRESS=0x38Dd26788Cf2d901E3aBf04efE3007d459d0Fc53

# ── BoLD ─────────────────────────────────────────────────────────────────────
# Base stake in WBNB for createRollup (default 0.02 mainnet / 0.01 testnet; see README §6)
BOLD_BASE_STAKE=

# ── Fee parameters (set-l2-params.ts) ────────────────────────────────────────
# USD per 1,000,000 gas (SPEC §3: $0.045)
USD_PER_MGAS=0.045
# ANTB/USD price used to derive the minimum L2 base fee (SPEC example: 97.17 → 463,105,383 wei)
ANTB_USD_PRICE=97.17
# BNB/USD price used to derive the L1 pricing reward rate and the fee-token pricer exchange rate
BNB_USD_PRICE=565
# BSC gas price assumed for the L1 reward rate (wei). Default: 0.05 gwei mainnet / 0.1 gwei testnet
BSC_GAS_PRICE_WEI=
# Address that receives L1 pricing rewards (ops wallet that refills the batch poster). Defaults to batch poster.
L1_PRICING_REWARD_RECIPIENT=
# Address that receives L2 network fees (sequencer revenue → 40/40/20 split). Defaults to chain owner.
NETWORK_FEE_ACCOUNT=

# ── Gateway (apps/chain/gateway) ─────────────────────────────────────────────
# AgentRegistry on the L2 (deployed by the L2 contracts deploy; see SPEC §7). Empty = parent-chain fallback only.
AGENT_REGISTRY_ADDRESS=
# Comma-separated addresses always allowed through the gateway (ops wallets)
GATEWAY_ALLOWLIST=
