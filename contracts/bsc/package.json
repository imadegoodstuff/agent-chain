{
  "name": "@agent-chain/bsc-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "AGENT CHAIN parent-chain (BSC) contracts: AgentRegistryMirror, GenesisSeatClaim, Bridge (Beta) gated by Agent ID / BAB",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:fork": "hardhat test test/Fork.test.ts",
    "new-deployer": "ts-node --transpile-only scripts/new-deployer.ts",
    "snapshot": "ts-node --transpile-only scripts/snapshot.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network bsc",
    "verify:testnet": "hardhat run scripts/verify.ts --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/verify.ts --network bsc",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@openzeppelin/contracts": "^5.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "chai": "^4.4.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
