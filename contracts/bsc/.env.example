# Copy to .env and fill in. NEVER commit .env.

# Deployer EOA private key (0x-prefixed). Generate one with: npm run new-deployer
DEPLOYER_PRIVATE_KEY=

# BscScan API key (https://bscscan.com/myapikey) used by hardhat-verify
BSCSCAN_API_KEY=

# Optional RPC overrides
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Optional: enable mainnet-fork tests (test/Fork.test.ts). Leave empty to skip them.
BSC_FORK_URL=

# Optional: RPC with full eth_getLogs history for scripts/snapshot.ts
# (most free public endpoints prune old logs; see README "Snapshot").
SNAPSHOT_RPC_URL=

# Optional: BAB token address passed to constructors (defaults to the BSC mainnet BABT
# on chainId 56 and to address(0) elsewhere).
BAB_ADDRESS=
